// Paste into script.google.com project attached to a Google Sheet.
// Set SCRIPT PROPERTY: PHOTO_FOLDER_ID = Google Drive folder ID for shop photos.
const HEADERS=['Survey ID','Type','N Code','Store Name','Channel - Sub Channel','Market','Locality','Creation Date','Address','Route','DIST','OB','TSM','Geo Coord','Omore','Walls','Hico','IC Handler','Segment','Comments','Exception','Reasons','Latitude','Longitude','GPS Accuracy (m)','Captured At','Photo URL','Server Received At'];
function setup(){const sheet=SpreadsheetApp.getActiveSpreadsheet().getSheetByName('Surveys')||SpreadsheetApp.getActiveSpreadsheet().insertSheet('Surveys');if(sheet.getLastRow()===0){sheet.appendRow(HEADERS);sheet.setFrozenRows(1)}}
function doPost(e){let id='';try{const r=JSON.parse(e.parameter.payload||'{}');id=String(r.id||'');if(!id||!r.store||!r.route||!r.ob||!r.photo||!Number.isFinite(Number(r.latitude))||!Number.isFinite(Number(r.longitude)))throw Error('Required data missing');const ss=SpreadsheetApp.getActiveSpreadsheet();const sh=ss.getSheetByName('Surveys');if(!sh)throw Error('Run setup() first');const lock=LockService.getScriptLock();lock.waitLock(25000);try{const ids=sh.getLastRow()>1?sh.getRange(2,1,sh.getLastRow()-1,1).getValues().flat():[];if(ids.includes(id))return response(id,true,'already uploaded');const folderId=PropertiesService.getScriptProperties().getProperty('PHOTO_FOLDER_ID');if(!folderId)throw Error('PHOTO_FOLDER_ID not configured');const match=r.photo.match(/^data:image\/jpeg;base64,(.+)$/);if(!match)throw Error('Invalid JPEG');const bytes=Utilities.base64Decode(match[1]);const file=DriveApp.getFolderById(folderId).createFile(Utilities.newBlob(bytes,'image/jpeg',id+'.jpg'));const keys=['type','ncode','store','channel','market','locality','creation','address','route','dist','ob','tsm'];const vals=keys.map(k=>safe(r[k]));const row=[id,...vals,`${r.latitude}, ${r.longitude}`,...['omore','walls','hico','handler','segment','comments','exception','reasons'].map(k=>safe(r[k])),Number(r.latitude),Number(r.longitude),Number(r.accuracy),safe(r.captured_at),file.getUrl(),new Date()];sh.appendRow(row);return response(id,true,'saved')}finally{lock.releaseLock()}}catch(err){return response(id,false,String(err.message||err))}}
function safe(v){let s=String(v==null?'':v).slice(0,1000);return /^[=+@\-\t\r]/.test(s)?"'"+s:s}
function response(id,ok,message){const obj=JSON.stringify({kind:'omore_result',id:id,ok:ok,error:ok?'':message});return HtmlService.createHtmlOutput('<script>parent.postMessage('+JSON.stringify(JSON.parse(obj))+',"*");</script>')}
